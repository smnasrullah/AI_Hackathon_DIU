# Copied to .env by run.bat / run.sh on first start. Never commit .env.

# --- Database (DATABASE_URL is built from these in docker-compose.yml) ---
POSTGRES_USER=agentpulse
POSTGRES_PASSWORD=agentpulse
POSTGRES_DB=agentpulse

# --- Host ports ---
FRONTEND_PORT=5173
BACKEND_PORT=8000

# --- App ---
SEED=42
# Placeholder only: run.bat / run.sh replace it with a random 64-hex value when creating .env.
# The backend refuses to start if JWT_SECRET is under 32 bytes.
JWT_SECRET=__GENERATED_ON_FIRST_RUN__
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
# Set true only when the app is served over HTTPS.
REFRESH_COOKIE_SECURE=false
# Optional risk cut-offs per horizon: P(stockout) for [amber, red]. Unset = defaults in
# backend/app/rules/risk_rules.py. Example: RISK_THRESHOLDS={"6": [0.1, 0.3], "24": [0.2, 0.5]}
# RISK_THRESHOLDS=

# --- Demo logins (synthetic accounts, seeded on bootstrap) ---
# admin@agentpulse.demo | dist.dhaka@ / dist.chattogram@ / dist.sylhet@agentpulse.demo
# agent.mirpur@ / agent.patiya@ / agent.sunamganj@agentpulse.demo
DEMO_ADMIN_PASSWORD=admin-demo-2026
DEMO_DISTRIBUTOR_PASSWORD=distributor-demo-2026
DEMO_AGENT_PASSWORD=agent-demo-2026

# --- LLM (optional; app works without a key via replay/template) ---
# auto | anthropic | openai_compatible | replay | template
LLM_PROVIDER=auto
LLM_MODEL=claude-haiku-4-5-20251001
# Only for openai_compatible (Gemini / Groq / Ollama), e.g. http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=8
